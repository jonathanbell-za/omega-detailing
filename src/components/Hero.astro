---
// Hero.astro
---

<section class="relative min-h-[90vh] flex items-center pt-36 md:pt-64 pb-20 overflow-hidden bg-neutral-900 font-sans border-b border-neutral-800">
  {/* Desktop Hero Background Image (Purple Porsche GT3) - Desktop ONLY */}
  <img 
    src="/hero-bg-desktop.jpg" 
    alt="Omega Mobile Detailing Desktop Background" 
    class="hidden md:block absolute inset-0 w-full h-full object-cover object-center"
  />

  {/* Mobile Hero Background Image (Blue Audi R8) - Mobile ONLY */}
  <img 
    src="/hero-bg-mobile.jpg" 
    alt="Omega Mobile Detailing Mobile Background" 
    class="block md:hidden absolute inset-0 w-full h-full object-cover object-center"
  />
  
  {/* Dark Gradient Overlay for Premium Contrast & Readability */}
  <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/35 to-black/60"></div>

  <!-- Content layer -->
  <div class="relative z-10 max-w-7xl px-6 w-full text-center mx-auto">
    <div class="max-w-6xl mx-auto space-y-12 animate-fade-in">
      {/* Heading text */}
      <div class="flex justify-center">
        <h1 class="text-3xl sm:text-5xl md:text-6xl max-w-5xl font-black text-white uppercase tracking-tight leading-tight drop-shadow-2xl">
          Detailing, Paint Correction, & Ceramic Coating Specialist
        </h1>
      </div>
      
      <p class="text-lg md:text-2xl text-neutral-200 max-w-3xl mx-auto font-black uppercase tracking-widest leading-relaxed drop-shadow-md hero-subtitle">
        Experience the Omega Standard
      </p>
      
      <div class="flex flex-col sm:flex-row gap-6 pt-6 justify-center">
        <a 
          href="https://wa.me/27605670893?text=Hi%20James!%20I%27d%20like%20to%20book%20a%20detailing%20session." 
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-12 py-6 font-black text-white bg-blue-600 transition-all duration-300 hover:bg-white hover:text-neutral-900 shadow-xl shadow-blue-600/30 uppercase tracking-widest text-base rounded-full"
        >
          Book Your Session
        </a>
        
        <a 
          href="/pricing" 
          class="inline-flex items-center justify-center px-12 py-6 font-black text-white border-2 border-white/40 bg-white/10 backdrop-blur-md transition-all duration-300 hover:border-white hover:bg-white hover:text-neutral-900 uppercase tracking-widest text-base rounded-full"
        >
          View Packages
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll Scroll -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10 animate-bounce">
    <div class="w-6 h-10 border-2 border-white/50 rounded-full flex justify-center pt-2">
      <div class="w-1 h-2 bg-blue-500 rounded-full"></div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeInRight {
    from { opacity: 0; transform: translateX(50px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .animate-fade-in {
    animation: fadeIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animate-fade-in-right {
    animation: fadeInRight 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  h1, .hero-subtitle { font-family: 'Inter', sans-serif; }
</style>
