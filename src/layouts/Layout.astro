---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Omega Detailing | South Africa's Premium Mobile Detailers",
  description = "South Africa's premier mobile vehicle detailing service, personally owned and operated by James Bell. Professional car care delivered directly to your door — Johannesburg & surrounds.",
  ogImage = "/og-preview.png",
} = Astro.props;

const siteUrl = "https://omegadetailing.co.za";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
---
<!doctype html>
<html lang="en" class="scroll-smooth bg-neutral-50">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=3" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=3" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico?v=3" />
		<link rel="shortcut icon" href="/favicon.ico?v=3" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
		<meta name="generator" content={Astro.generator} />

		{/* Primary Meta */}
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />

		{/* Open Graph / Facebook / WhatsApp / LinkedIn */}
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="Omega Detailing" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Omega Detailing — South Africa's Premium Mobile Detailers" />
		<meta property="og:locale" content="en_ZA" />

		{/* Twitter / X Card */}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content="Omega Detailing — South Africa's Premium Mobile Detailers" />

		{/* Fonts */}
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
	</head>
	<body class="text-neutral-900 overflow-x-hidden min-h-screen relative font-sans">
    {/* Global Blue Border Frame */}
    <div class="fixed inset-0 border-[6px] border-blue-600 pointer-events-none z-[100]"></div>
		<slot />

    {/* Floating WhatsApp Button */}
    <a
      id="whatsapp-fab"
      href="https://wa.me/27605670893"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat with us on WhatsApp"
    >
      <span class="whatsapp-tooltip">Chat with James</span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="34" height="34" class="z-10">
        <path fill-rule="evenodd" d="M4.804 2.168A2.25 2.25 0 002.25 4.416v9.168c0 1.243 1.007 2.25 2.254 2.25h3.696v3.158c0 .546.62.854 1.045.513l4.577-3.671h4.424a2.25 2.25 0 002.25-2.25V4.416a2.25 2.25 0 00-2.25-2.248H4.804zM7.5 8.25a.75.75 0 01.75-.75h7.5a.75.75 0 010 1.5h-7.5a.75.75 0 01-.75-.75zm0 3a.75.75 0 01.75-.75h4.5a.75.75 0 010 1.5h-4.5a.75.75 0 01-.75-.75z" clip-rule="evenodd" />
      </svg>
    </a>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
	
	::selection {
		background-color: #3b82f6;
		color: white;
	}

  /* ── Floating WhatsApp Button ── */
  #whatsapp-fab {
    position: fixed;
    bottom: 32px;
    right: 32px;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #2563eb;
    color: #fff;
    box-shadow: 0 6px 28px rgba(37, 99, 235, 0.5);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    text-decoration: none;
  }

  #whatsapp-fab:hover {
    transform: scale(1.1);
    box-shadow: 0 8px 32px rgba(37, 99, 235, 0.6);
  }

  /* Pulse ring */
  #whatsapp-fab::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(37, 99, 235, 0.4);
    animation: wa-pulse 2.2s ease-out infinite;
  }

  @keyframes wa-pulse {
    0%   { transform: scale(1);   opacity: 0.7; }
    70%  { transform: scale(1.7); opacity: 0;   }
    100% { transform: scale(1.7); opacity: 0;   }
  }

  /* Tooltip */
  .whatsapp-tooltip {
    position: absolute;
    right: calc(100% + 12px);
    white-space: nowrap;
    background: #111;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 6px 12px;
    border-radius: 6px;
    pointer-events: none;
    opacity: 0;
    transform: translateX(6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .whatsapp-tooltip::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 100%;
    transform: translateY(-50%);
    border: 5px solid transparent;
    border-left-color: #111;
  }

  #whatsapp-fab:hover .whatsapp-tooltip {
    opacity: 1;
    transform: translateX(0);
  }
</style>
